# Build context for the test image (docker build -f Dockerfile.test, BuildKit).
# Unlike .dockerignore, this keeps tests/ and the files the tests read.
.git/
.venv/
venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
*.md
!RELEASE_NOTES.md
!README.md
!terraform/README.md
LICENSE
assets/
terraform/.terraform/
terraform/terraform.tfvars
*.tfstate
*.tfstate.*
.DS_Store
.env
*.log
