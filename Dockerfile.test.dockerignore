# Build context for the test image (docker build -f Dockerfile.test, BuildKit).
# Unlike .dockerignore, this keeps tests/ and the files the tests read.
.git/
.github/
.venv/
venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
*.md
!RELEASE_NOTES.md
!README.md
!terraform/README.md
# *.md matches the root only; said explicitly: the tests read docs/ (test_terraform.py, since v20).
!docs/*.md
LICENSE
assets/*
!assets/gcp_best_practices.csv
!assets/cloud_armor_rulesets.json
# The logo the pages inline: test_design.py pins app/templates/_logo.html to these two files (v20.0.1).
!assets/cloudgauge_icon.svg
!assets/cloudgauge_logo.svg
terraform/.terraform/
terraform/terraform.tfvars
*.tfstate
*.tfstate.*
.DS_Store
.env
*.log
